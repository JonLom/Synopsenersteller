# Anthropic API Configuration
ANTHROPIC_API_KEY=your_api_key_here

# Streaming Configuration (Optional)
# Set to 'true' to enable real-time streaming updates in the UI
# Set to 'false' for simple "Thinking..." placeholder (default)
ENABLE_STREAMING=false

# Extended Thinking (Optional)
# Only applies when ENABLE_STREAMING=true
# Uses Claude's extended thinking API feature to show the agent's reasoning process
# Includes both real-time thinking and a summary from Claude
ENABLE_THINKING=false

# Thinking Budget (Optional)
# Maximum tokens allocated for extended thinking (default: 10000)
# Only applies when ENABLE_THINKING=true
# See: https://platform.claude.com/docs/en/build-with-claude/extended-thinking
THINKING_BUDGET=10000
